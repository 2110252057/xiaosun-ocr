<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      摄像头实时识别（CameraOcrActivity）。
      required=false：没有摄像头的设备（电视、部分平板）照样能安装本应用，
      只是那一页打不开 —— 其余 OCR / 手势功能完全不受影响。
      权限是运行时申请的（进那一页时才要），不在启动时骚扰用户。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 前台服务：保证进程在后台/息屏时不轻易被回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 申请忽略电池优化（Doze 白名单），避免息屏后 CPU 被冻结 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 开机自启，保证长时间无人值守时服务始终可用 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 唤醒锁：请求处理期间保持 CPU 清醒，防止息屏时响应超时 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      应用私有权限（签名级）。

      【修复⑭】OCRService 是 exported=true 的（必须如此，否则自动化脚本
      无法用 am start-foreground-service 拉起它），但原来**任何 App** 都能
      随意开始/停止它。现在用它做一层调用者校验：
        · 声明为 signature 级 —— 只有同签名的应用才拿得到这个权限
        · 服务侧用 checkCallingPermission() 校验
      于是：外部脚本用 am/shell 拉起照样成功（Uid 2000 系统/shell 不受限），
      而第三方 App 的偷偷拉起/停止会被拒绝。不影响任何既有用法。
    -->
    <permission
        android:name="com.xiaosun.ocr.permission.CONTROL_SERVICE"
        android:protectionLevel="signature" />

    <!-- 屏幕截图（MediaProjection） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      悬浮窗权限（SYSTEM_ALERT_WINDOW）。

      ★ 为什么必须要它
      插件的执行入口是 BroadcastReceiver（后台广播），受两条 Android 限制：
        1. Android 12+ 禁止后台应用调用 startForegroundService()
        2. MediaProjection 授权必须由 Activity 发起（createScreenCaptureIntent 是 Activity API）
      于是"没有后台服务时，插件无法截屏识别"。

      而拥有 SYSTEM_ALERT_WINDOW 的应用被系统视为"用户可见的前台应用"，
      可以：
        · 从后台启动 Activity（用于弹出截屏授权框）
        · 从后台启动前台服务
      这两点正好解开上面两个限制。

      注意：该权限不会自动授予，需要引导用户在系统设置里手动开启
      （见 MainActivity 的「悬浮窗权限」引导）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
      包可见性（Android 11+ / API 30+）。

      ★ 为什么必须要
      从 Android 11 起，应用默认只能「看见」自己、系统组件、以及少数
      被显式声明过的包。targetSdk 34 的情况下，直接调用
          getPackageManager().getApplicationIcon("com.tencent.mm")
      对没声明过的包会抛 NameNotFoundException —— 表现就是菜单项里
      填 app:com.tencent.mm 拿不到图标，预览框空着。

      ★ 两个手段，同时用
      1) QUERY_ALL_PACKAGES：一次性看得到所有已安装应用。
         本应用是自用的手势/自动化工具（已声明 MANAGE_EXTERNAL_STORAGE），
         不经过应用商店分发，用它是合适的。
      2) <queries> 里的 MAIN/LAUNCHER intent：凡是带启动图标的 App 都
         能响应这个 intent，于是它们全都可见。属于「即使拿不到上面那条
         权限也能work」的兜底，两条路任一生效即可。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 常见目标应用，直接点名，最保险 -->
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
          【修复⑬】备份范围收窄。
          allowBackup 仍为 true（保留档位等常规偏好），但通过下面两个属性
          显式排除 xsocr_last —— 它存着最近一次识别出的**全部屏幕文本**，
          之前会被云备份/换机直传原样带走：
            · fullBackupContent   → 覆盖 API ≤ 30
            · dataExtractionRules → 覆盖 API ≥ 31（Android 12 起改用新文件）
          两个属性只对应各自版本区间，都必须写。

          【修复⑫】原 android:usesCleartextTraffic="true" 已移除，
          改为 networkSecurityConfig 白名单式放行（默认禁明文，仅 127.0.0.1/localhost）。
          这样本地 OCR 接口照常，而其它任何 http:// 明文请求都会被系统拦下。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          截屏授权中转 Activity。

          插件（BroadcastReceiver）无法直接弹 MediaProjection 授权框，
          于是由它代为发起。设为：
            · exported=false      —— 只允许本应用拉起，避免被外部滥用
            · 透明主题             —— 用户只看到系统授权弹窗
            · excludeFromRecents   —— 不进入最近任务列表
            · taskAffinity=""      —— 独立任务栈，不与主界面混在一起

          ⚠️ 刻意**不加 noHistory**：
          弹系统授权框时本 Activity 会进入 onPause，
          若设了 noHistory 就会被立即销毁，导致 onActivityResult 收不到结果。
        -->
        <activity
            android:name=".ScreenCaptureRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/TransparentCaptureTheme" />

        <!--
          与原版一致：导出的前台服务，供自动化脚本用 am start-foreground-service 拉起。
          stopWithTask=false：从最近任务划掉 App 时服务不被杀，外部调用不会中断。
          mediaProjection：支持不传图片、由接口自行截屏识别。

          【修复⑭】服务侧已加调用者校验（见 OCRService.onStartCommand）：
          exported 必须保持 true 才能被 am/shell 拉起，所以不能靠改 exported 收紧，
          改为在 onStartCommand 里用 checkCallingPermission 校验：
          系统 / shell（automation 脚本的发起者）不受限，第三方 App 会被拒绝。
        -->
        <!--
          无障碍截图服务（Android 11+）。

          【它是什么】用户只在系统「无障碍」列表里勾选一次，之后本应用就能
          随时调用 takeScreenshot() 截图 —— 不需要 root，也不再弹录屏授权框。
          这正是宏/无人值守场景最缺的一条路：MediaProjection 每次重启都
          要用户手点一次，root 又不是每台机器都有。

          【它不做什么】onAccessibilityEvent 是空实现，配置里也没声明任何
          accessibilityEventTypes —— 它收不到屏幕文本、控件树、点击或按键，
          只保留「截图」这一项能力。

          BIND_ACCESSIBILITY_SERVICE 是系统级权限：只有系统能绑定本服务，
          第三方应用无法自行拉起它。
        -->
        <service
            android:name=".OcrAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".OCRService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="specialUse|mediaProjection"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="OCR and Local Web Server for Automation" />
        </service>

        <!--
          开机 / 应用更新后自动拉起服务。

          【修复⑭】exported 由 true 改为 false。
          它监听的 BOOT_COMPLETED / MY_PACKAGE_REPLACED / QUICKBOOT_POWERON
          都是**系统受保护广播**，只有系统能发送；而系统广播不受 exported
          限制，所以改成 false 后功能完全不受影响，却顺手堵掉了
          "第三方 App 自己伪造 BOOT_COMPLETED 来拉起本服务"这条路。
          （Android 官方对"只收系统广播"的 receiver 也是这个建议。）
        -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ==================== Tasker/Locale 插件（MacroDroid 兼容） ====================
             MacroDroid 扫两份列表，认两套协议：

               「动作」列表 ← com.twofortyfouram.locale.intent.action.EDIT_SETTING
               「触发器」列表 ← net.dinglisch.android.tasker.ACTION_EDIT_EVENT

             ★ 关于「触发器」，只提供**事件**这一种身份。

               插件本身在历史上也声明过 EDIT_CONDITION（条件身份），于是宿主
               触发器列表里会同时出现「小孙OCR · 边缘滑动手势」与
               「小孙OCR · 边缘滑动事件」两个条目，功能、配置界面完全一样，
               差别只在事件身份附带防伪数据（随机 message id + 60 秒有效期），
               条件身份只能读进程内的「最近一次手势」快照。

               两个入口并列是纯粹的干扰 —— 用户不知道挑哪个，还可能两个都配
               导致同一次滑动触发两遍。所以条件身份已撤除，只留事件：

                 OcrActionConfigActivity   ← EDIT_SETTING     动作：识别屏幕文字
                 TaskerEventConfigActivity ← ACTION_EDIT_EVENT 事件：等某个手势（带防伪）

               两者都 alias 到同一个 PluginEditActivity，靠 Intent 的 action
               区分显示哪套 UI（见 PluginEditActivity.applyMode）。
               用 activity-alias 而不是各写一个 Activity：它们除"在列表里叫什么
               名字"外完全一致，别名只多一行 android:label 就能各说各话。
              ============================================================================ -->

        <!--
          【修复⑭：本组组件的评估结论 —— 保持 exported=true，且不加权限】

          它们必须导出，否则宿主（MacroDroid / Tasker）既拉不起配置界面，
          也发不出执行/查询广播，插件功能直接失效。

          也不能像 OCRService 那样挂 signature 级权限：
          宿主是**第三方应用、不同签名**，一旦加权限，
          插件在所有宿主上都会静默失效（比不修还糟）。

          所以这里按"零风险原则"处理，不为账面好看牺牲兼容性：
            · OCRService   → 已加 isCallerAllowed() 调用者校验（exported 保持 true）
            · BootReceiver → 已改为 exported=false（只收系统广播，零影响）
            · 本组组件     → 只能保持开放；其能力本身也有限
                             （配置界面、触发识别、回答"手势成立吗"），
                             不涉及越权数据访问。
          今后若要收紧，唯一可行方向是**包名白名单**，
          但宿主不可枚举，会破坏兼容，故明确不做。
        -->

        <!--
          配置界面本体。
          ★ 它自己不挂任何 intent-filter —— 只作为两个别名的 targetActivity 存在。

          为什么要这样收：此前它直接声明了 EDIT_CONDITION，于是宿主的
          触发器列表里出现了「小孙OCR · 边缘滑动手势」（条件身份）。
          但条件身份没有防伪数据，只能读进程内的「最近一次手势」快照，
          理论上一条伪造广播就能骗过它；而事件身份带随机 message id +
          60 秒有效期，是真的验过才认。两个入口功能一样、配置界面一样，
          留着条件只会让人在列表里挑错，所以把条件身份去掉，
          只留下面那个带防伪的事件别名。
        -->
        <activity
            android:name=".PluginEditActivity"
            android:exported="true"
            android:theme="@style/PluginDialogTheme" />

        <!--
          动作身份：识别屏幕文字。

          做成 alias 而不是写在本体上，只是为了**名字**：
          本体没有自己的 label，动作别名在动作列表里叫「小孙OCR」，
          事件别名在触发器列表里叫「小孙OCR · 边缘滑动事件」，
          各说各话、不互相误导。两个身份共用同一个 Activity 类，代码零重复。

          theme 也显式写死，避免 alias 继承行为在不同 ROM 上出现差异
          （这类差异排查起来很费时间）。
        -->
        <activity-alias
            android:name=".OcrActionConfigActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/PluginDialogTheme"
            android:targetActivity=".PluginEditActivity">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
          事件身份：手势触发器。
          必须用 activity-alias 且 target 指向配置界面 —— 这是原版
          com.dxam.presencedetector 的做法（它也是 alias 到 PluginConfigActivity）。
          alias 的 label 决定它在宿主「事件」列表里的显示名，
          也就是用户在宏里看到的「小孙OCR · 边缘滑动事件」。
        -->
        <activity-alias
            android:name=".TaskerEventConfigActivity"
            android:exported="true"
            android:label="@string/tasker_event_name"
            android:theme="@style/PluginDialogTheme"
            android:targetActivity=".PluginEditActivity">
            <intent-filter>
                <action android:name="net.dinglisch.android.tasker.ACTION_EDIT_EVENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".PluginFireReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!--
          条件查询的应答者。
          ★ 名字容易让人误会：它**不只是**给「条件身份」用的。
          真正的作用是：插件广播 REQUEST_QUERY 说「刚滑了一下」之后，
          宿主会回头往这里发 QUERY_CONDITION 问「真的吗？哪个方向？」，
          我们 setResultCode(16/17/18) 回答 —— 这条查询是宏被触发的起点。
          没有它，事件型触发器就只是单向喊话，宏永远不跑。
        -->
        <receiver
            android:name=".PluginConditionReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.QUERY_CONDITION" />
            </intent-filter>
        </receiver>

        <!-- ==================== 边缘滑动手势触发器 ====================
             三个组件各司其职：
               EdgeGestureActivity       —— 设置主页（总开关 / 触控区域 / 手柄列表）
               EdgeGestureEditorActivity —— 单个手柄的编辑页（尺寸、颜色、8 方向、触发距离）
               EdgeGestureService        —— 前台服务 + 悬浮窗手势引擎（真正抓触摸的地方）

             为什么要用**悬浮窗**而不是普通 View：
             手势要能覆盖在任意 App 之上（包括桌面、游戏），
             只有 TYPE_APPLICATION_OVERLAY 窗口才拿得到跨应用触摸事件。
             而 SYSTEM_ALERT_WINDOW 同时又让本应用被视为「用户可见」，
             于是能顺理成章地从后台拉起前台服务（Android 12+ 限制）。

             注意 EdgeGestureService 是 exported=false：
              它只由本应用拉起，外部应用无权直接启动。
              手势结果通过插件（Locale 协议）回传，不走对外广播。
             ============================================================ -->
        <activity
            android:name=".EdgeGestureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="边缘滑动触发" />
        <activity
            android:name=".EdgeGestureEditorActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="编辑滑动手柄" />
        <!--
          滑动菜单的配置页。
          菜单由本应用自己弹（悬浮窗已经拿住了那次触摸），本页只负责
          配置它长什么样：菜单项、图标、布局。宏只读回传的结果。
        -->
        <activity
            android:name=".EdgeGestureMenuActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="滑动菜单" />
        <!--
          摄像头实时识别页。
          · 锁定竖屏：预览的旋转补偿按竖屏算好了，允许横屏还得再补一套
            方向换算，收益不大。
          · adjustResize：底部结果面板要能跟着输入法/系统栏变化。
          · exported=false：只从「OCR设置」这张卡片进，外部无权拉起
            （拉起就会占用摄像头，对用户是骚扰）。
        -->
        <activity
            android:name=".CameraOcrActivity"
            android:exported="false"
            android:label="摄像头实时识别"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".EdgeGestureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Edge Swipe Gesture Trigger" />
        </service>

        <!--
          日志文件的分享通道。

          AppLog 把日志写在 Android/data/com.xiaosun.ocr/files/logs/ 下，
          这是应用私有外部目录，别的应用直接读不到。要让微信/QQ/邮件
          收得到，必须包一层 FileProvider 给出 content:// URI
          （Android 7.0 起传 file:// 会抛 FileUriExposedException）。

          authority 必须与 AppLog.AUTHORITY 一字不差：
              com.xiaosun.ocr.fileprovider
          exported=false + grantUriPermissions=true 是标准组合：
          不导出给所有人，只在分享那一刻把单个文件的读权限临时授出去。
          可分享的路径白名单见 res/xml/file_paths.xml（只开了 logs/ 目录）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.xiaosun.ocr.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
</application>

</manifest>