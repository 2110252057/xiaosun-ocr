<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 前台服务：保证进程在后台/息屏时不轻易被回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 申请忽略电池优化（Doze 白名单），避免息屏后 CPU 被冻结 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 开机自启，保证长时间无人值守时服务始终可用 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 唤醒锁：请求处理期间保持 CPU 清醒，防止息屏时响应超时 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 屏幕截图（MediaProjection） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!--
      悬浮窗权限（SYSTEM_ALERT_WINDOW）。

      ★ 为什么必须要它
      插件的执行入口是 BroadcastReceiver（后台广播），受两条 Android 限制：
        1. Android 12+ 禁止后台应用调用 startForegroundService()
        2. MediaProjection 授权必须由 Activity 发起（createScreenCaptureIntent 是 Activity API）
      于是"没有后台服务时，插件无法截屏识别"。

      而拥有 SYSTEM_ALERT_WINDOW 的应用被系统视为"用户可见的前台应用"，
      可以：
        · 从后台启动 Activity（用于弹出截屏授权框）
        · 从后台启动前台服务
      这两点正好解开上面两个限制。

      注意：该权限不会自动授予，需要引导用户在系统设置里手动开启
      （见 MainActivity 的「悬浮窗权限」引导）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          截屏授权中转 Activity。

          插件（BroadcastReceiver）无法直接弹 MediaProjection 授权框，
          于是由它代为发起。设为：
            · exported=false      —— 只允许本应用拉起，避免被外部滥用
            · 透明主题             —— 用户只看到系统授权弹窗
            · excludeFromRecents   —— 不进入最近任务列表
            · taskAffinity=""      —— 独立任务栈，不与主界面混在一起

          ⚠️ 刻意**不加 noHistory**：
          弹系统授权框时本 Activity 会进入 onPause，
          若设了 noHistory 就会被立即销毁，导致 onActivityResult 收不到结果。
        -->
        <activity
            android:name=".ScreenCaptureRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/TransparentCaptureTheme" />

        <!--
          与原版一致：导出的前台服务，供自动化脚本用 am start-foreground-service 拉起。
          stopWithTask=false：从最近任务划掉 App 时服务不被杀，外部调用不会中断。
          mediaProjection：支持不传图片、由接口自行截屏识别。
        -->
        <service
            android:name=".OCRService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="specialUse|mediaProjection"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="OCR and Local Web Server for Automation" />
        </service>

        <!-- 开机 / 应用更新后自动拉起服务 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ==================== Tasker/Locale 插件（MacroDroid 兼容） ====================
             MacroDroid 的「Tasker/Locale Plugin」动作会扫描设备上符合该规范的 App。
             我们只要声明好这两个组件，就会出现在它的插件列表里。

             规范要点：
               Activity          —— 响应 ACTION_EDIT_SETTING，负责配置界面
               BroadcastReceiver —— 响应 ACTION_FIRE_SETTING，负责实际执行
             ============================================================================ -->

        <activity
            android:name=".PluginEditActivity"
            android:exported="true"
            android:label="小孙OCR"
            android:theme="@style/PluginDialogTheme">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PluginFireReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

    </application>

</manifest>