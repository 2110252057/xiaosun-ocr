# ============================================================
# Android / Gradle 构建产物
# ------------------------------------------------------------
# 这些目录加起来 300+MB，且完全可以从源码重新生成，
# 提交上去只会让仓库臃肿、克隆变慢。
# ============================================================

# Gradle 构建输出
/build/
/app/build/
*/build/

# Gradle 缓存与状态
.gradle/
/app/.gradle/

# 本地环境配置（含机器专属路径，不应共享）
local.properties

# AndroidIDE / AIDE 等 IDE 的私有数据
.acside/
.backup/

# ============================================================
# 编译中间产物（部分可能出现在非标准位置）
# ============================================================
*.apk
*.aab
*.ap_
*.dex
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# native 构建中间产物
.cxx/
obj/
/app/.cxx/

# ============================================================
# 签名文件（★ 切勿提交，泄露等于他人可冒充你发布）
# ============================================================
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# ============================================================
# 编辑器 / 系统垃圾文件
# ============================================================
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.log

# ============================================================
# 注意：以下内容**必须提交**，不要加进忽略列表
# ------------------------------------------------------------
#   app/src/main/jniLibs/**   native 库（libnjocr.so 等，17MB）
#   app/src/main/assets/**    OCR 模型文件（*.bin、keys.txt）
#   gradle/wrapper/**         Gradle Wrapper（保证他人能直接构建）
#   gradlew / gradlew.bat
# ============================================================
